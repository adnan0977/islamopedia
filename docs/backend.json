
{
  "entities": {
    "HadithEdition": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "HadithEdition",
      "type": "object",
      "description": "Represents a specific edition or collection of Hadith, providing metadata about the collection sourced from an external API.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the HadithEdition (e.g., 'bukhari')."
        },
        "collectionName": {
          "type": "string",
          "description": "The common name of the Hadith collection."
        },
        "title": {
          "type": "string",
          "description": "The full, human-readable title of the Hadith edition."
        },
        "language": {
          "type": "string",
          "description": "The ISO 639-1 language code."
        },
        "textDirection": {
          "type": "string",
          "description": "The text direction (ltr/rtl)."
        },
        "publisher": {
          "type": "string",
          "description": "The publisher attributed to this edition."
        },
        "category": {
          "type": "string",
          "description": "The category (e.g., 'sunnah')."
        }
      },
      "required": [
        "id",
        "title",
        "language"
      ]
    },
    "Video": {
      "title": "Video",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "channelId": { "type": "string" },
        "publishedAt": { "type": "string" },
        "isTrending": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "appViewCount": { "type": "number" }
      }
    },
    "Channel": {
      "title": "Channel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "isActive": { "type": "boolean" }
      }
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "/hadith_editions/{hadithEditionId}": {
      "schema": "HadithEdition",
      "description": "Metadata for Hadith collections."
    },
    "/videos/{videoId}": {
      "schema": "Video",
      "description": "Cataloged spiritual videos."
    },
    "/channels/{channelId}": {
      "schema": "Channel",
      "description": "Linked YouTube channels."
    },
    "/roles_admin/{userId}": {
      "schema": "object",
      "description": "Admin privileges marker."
    },
    "/settings/{settingId}": {
      "schema": "object",
      "description": "Global application configuration."
    },
    "/speakers/{speakerId}": {
      "schema": "object",
      "description": "Featured scholars and speakers."
    },
    "/quran/{surahId}": {
      "schema": "object",
      "description": "Quranic text and translations."
    },
    "/quran_editions/{editionId}": {
      "schema": "object",
      "description": "Metadata for Quran editions."
    },
    "/quran_metadata/{metaId}": {
      "schema": "object",
      "description": "Structural Quran data."
    }
  }
}
