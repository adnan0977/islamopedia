
{
  "entities": {
    "Video": {
      "title": "Video",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "channelId": { "type": "string" },
        "publishedAt": { "type": "string" },
        "isTrending": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "appViewCount": { "type": "number" }
      }
    },
    "HadithBook": {
      "title": "Hadith Book",
      "description": "A primary collection of Hadith from HadithAPI.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bookName": { "type": "string" },
        "bookSlug": { "type": "string" },
        "writerName": { "type": "string" },
        "writerDeath": { "type": "string" },
        "hadiths_count": { "type": "string" },
        "chapters_count": { "type": "string" },
        "isActive": { "type": "boolean" },
        "lastSyncedAt": { "type": "string" }
      }
    },
    "HadithSlug": {
      "title": "Hadith Slug",
      "description": "A mapping of Book Name to its official URL/API slug.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bookName": { "type": "string" },
        "slug": { "type": "string" }
      },
      "required": ["bookName", "slug"]
    },
    "HadithEdition": {
      "title": "Hadith Edition",
      "description": "A specific language version of a Hadith book.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bookId": { "type": "string" },
        "language": { "type": "string" },
        "editionName": { "type": "string" },
        "isActive": { "type": "boolean" },
        "lastSyncedAt": { "type": "string" }
      },
      "required": ["bookId", "language"]
    },
    "HadithIndex": {
      "title": "Hadith Index",
      "description": "Chapter definitions for a Hadith book.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bookSlug": { "type": "string" },
        "chapterNumber": { "type": "string" },
        "chapterArabic": { "type": "string" },
        "chapterEnglish": { "type": "string" },
        "chapterUrdu": { "type": "string" }
      }
    },
    "HadithContent": {
      "title": "Hadith Content",
      "description": "Individual Hadith records.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "editionId": { "type": "string" },
        "bookId": { "type": "string" },
        "hadithNumber": { "type": "string" },
        "arabicText": { "type": "string" },
        "translatedText": { "type": "string" },
        "chapterName": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "/videos/{videoId}": {
      "schema": "Video",
      "description": "Cataloged spiritual videos."
    },
    "/channels/{channelId}": {
      "schema": "object",
      "description": "Linked YouTube channels."
    },
    "/roles_admin/{userId}": {
      "schema": "object",
      "description": "Admin marker."
    },
    "/settings/{settingId}": {
      "schema": "object",
      "description": "Global config."
    },
    "/speakers/{speakerId}": {
      "schema": "object",
      "description": "Scholars and speakers."
    },
    "/quran/{surahId}": {
      "schema": "object",
      "description": "Quranic text."
    },
    "/quran_editions/{editionId}": {
      "schema": "object",
      "description": "Quran metadata."
    },
    "/quran_metadata/{metaId}": {
      "schema": "object",
      "description": "Structural Quran data."
    },
    "/hadith_books/{bookId}": {
      "schema": "HadithBook",
      "description": "Registry of primary Hadith collections."
    },
    "/hadith_slug/{slugId}": {
      "schema": "HadithSlug",
      "description": "Official slug mapping for Hadith collections."
    },
    "/hadith_editions/{editionId}": {
      "schema": "HadithEdition",
      "description": "Language-specific editions of Hadith books."
    },
    "/hadith_index/{indexId}": {
      "schema": "HadithIndex",
      "description": "Chapter index for Hadith books."
    },
    "/hadith_data/{contentId}": {
      "schema": "HadithContent",
      "description": "Individual Hadith records."
    }
  }
}
