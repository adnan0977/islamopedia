
{
  "entities": {
    "Video": {
      "title": "Video",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "channelId": { "type": "string" },
        "publishedAt": { "type": "string" },
        "isTrending": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "appViewCount": { "type": "number" }
      }
    },
    "HadithBook": {
      "title": "Hadith Book",
      "description": "A primary collection of Hadith (e.g., Sahih Bukhari).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "collectionName": { "type": "string" },
        "englishName": { "type": "string" },
        "arabicName": { "type": "string" },
        "hadithCount": { "type": "number" },
        "description": { "type": "string" },
        "isActive": { "type": "boolean" }
      }
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "/videos/{videoId}": {
      "schema": "Video",
      "description": "Cataloged spiritual videos."
    },
    "/channels/{channelId}": {
      "schema": "object",
      "description": "Linked YouTube channels."
    },
    "/roles_admin/{userId}": {
      "schema": "object",
      "description": "Admin marker."
    },
    "/settings/{settingId}": {
      "schema": "object",
      "description": "Global config."
    },
    "/speakers/{speakerId}": {
      "schema": "object",
      "description": "Scholars and speakers."
    },
    "/quran/{surahId}": {
      "schema": "object",
      "description": "Quranic text."
    },
    "/quran_editions/{editionId}": {
      "schema": "object",
      "description": "Quran metadata."
    },
    "/quran_metadata/{metaId}": {
      "schema": "object",
      "description": "Structural Quran data."
    },
    "/hadith_books/{bookId}": {
      "schema": "HadithBook",
      "description": "Registry of primary Hadith collections."
    }
  }
}
