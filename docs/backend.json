
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's profile information and personalized settings within the VlogNest application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the UserProfile entity."
        },
        "youtubeChannelId": {
          "type": "string",
          "description": "Reference to the user's primary linked YouTubeChannel, if connected."
        },
        "favoriteVideoIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "namazLocation": {
          "type": "string",
          "description": "The user's location used for calculating Namaz timings."
        },
        "hijriAdjustment": {
          "type": "number"
        },
        "lastReadPage": {
          "type": "number",
          "description": "The last page the user was reading in the Quran."
        },
        "preferredTranslationId": {
          "type": "string",
          "description": "The identifier of the user's preferred Quran translation edition."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "namazLocation"
      ]
    },
    "YouTubeChannel": {
      "title": "YouTubeChannel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "thumbnailUrl": { "type": "string", "format": "uri" },
        "externalUrl": { "type": "string", "format": "uri" },
        "subscribersCount": { "type": "number" },
        "videoCount": { "type": "number" },
        "viewCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "thumbnailUrl", "externalUrl"]
    },
    "YouTubeVideo": {
      "title": "YouTubeVideo",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "thumbnailUrl": { "type": "string", "format": "uri" },
        "externalUrl": { "type": "string", "format": "uri" },
        "duration": { "type": "string" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "channelId": { "type": "string" },
        "uploadedByUserId": { "type": "string" },
        "speakerIds": { "type": "array", "items": { "type": "string" } },
        "youtubeViewCount": { "type": "number" },
        "appViewCount": { "type": "number" },
        "likeCount": { "type": "number" },
        "isTrending": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "thumbnailUrl", "externalUrl", "channelId"]
    },
    "QuranEdition": {
      "title": "QuranEdition",
      "type": "object",
      "description": "Represents an activated Quran edition (translation or original).",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "language": { "type": "string" },
        "languageCode": { "type": "string" },
        "isDefault": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "dataSync": { "type": "string", "enum": ["yes", "no"] }
      },
      "required": ["id", "name", "language", "languageCode"]
    },
    "QuranPage": {
      "title": "QuranPage",
      "type": "object",
      "description": "Represents a single page of the Quran for a specific edition, cached in Firestore.",
      "properties": {
        "id": { "type": "string", "description": "Format: {editionId}_page_{pageNumber}" },
        "editionId": { "type": "string" },
        "pageNumber": { "type": "number" },
        "ayats": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "number": { "type": "number" },
              "text": { "type": "string" },
              "translationText": { "type": "string" },
              "surah": {
                "type": "object",
                "properties": {
                  "number": { "type": "number" },
                  "name": { "type": "string" },
                  "englishName": { "type": "string" }
                }
              },
              "numberInSurah": { "type": "number" }
            }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "editionId", "pageNumber", "ayats"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": { "entityName": "UserProfile" }
      },
      {
        "path": "/channels/{channelId}",
        "definition": { "entityName": "YouTubeChannel" }
      },
      {
        "path": "/videos/{videoId}",
        "definition": { "entityName": "YouTubeVideo" }
      },
      {
        "path": "/quran_editions/{editionId}",
        "definition": { "entityName": "QuranEdition" }
      },
      {
        "path": "/quran/{pageId}",
        "definition": { "entityName": "QuranPage" }
      },
      {
        "path": "/roles_admin/{adminId}",
        "definition": { "entityName": "UserProfile" }
      }
    ]
  }
}
