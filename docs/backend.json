
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's profile information and personalized settings within the VlogNest application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the UserProfile entity."
        },
        "youtubeChannelId": {
          "type": "string",
          "description": "Reference to the user's primary linked YouTubeChannel, if connected."
        },
        "favoriteVideoIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "namazLocation": {
          "type": "string",
          "description": "The user's location used for calculating Namaz timings."
        },
        "hijriAdjustment": {
          "type": "number"
        },
        "lastReadPage": {
          "type": "number",
          "description": "The last page the user was reading in the Quran."
        },
        "preferredTranslationId": {
          "type": "string",
          "description": "The identifier of the user's preferred Quran translation edition."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "namazLocation"
      ]
    },
    "YouTubeChannel": {
      "title": "YouTubeChannel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "thumbnailUrl": { "type": "string", "format": "uri" },
        "externalUrl": { "type": "string", "format": "uri" },
        "subscribersCount": { "type": "number" },
        "videoCount": { "type": "number" },
        "viewCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "thumbnailUrl", "externalUrl"]
    },
    "YouTubeVideo": {
      "title": "YouTubeVideo",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "thumbnailUrl": { "type": "string", "format": "uri" },
        "externalUrl": { "type": "string", "format": "uri" },
        "duration": { "type": "string" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "channelId": { "type": "string" },
        "uploadedByUserId": { "type": "string" },
        "speakerIds": { "type": "array", "items": { "type": "string" } },
        "youtubeViewCount": { "type": "number" },
        "appViewCount": { "type": "number" },
        "likeCount": { "type": "number" },
        "isTrending": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "thumbnailUrl", "externalUrl", "channelId"]
    },
    "QuranTranslation": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "QuranTranslation",
      "type": "object",
      "description": "Represents an activated Quran translation edition.",
      "properties": {
        "id": {
          "type": "string",
          "description": "The unique identifier of the translation edition (e.g., 'en.sahih')."
        },
        "name": {
          "type": "string",
          "description": "The full name of the translation."
        },
        "language": {
          "type": "string",
          "description": "The language name (e.g., 'English')."
        },
        "languageCode": {
          "type": "string",
          "description": "The language code (e.g., 'en')."
        },
        "isDefault": {
          "type": "boolean"
        },
        "isActive": {
          "type": "boolean"
        }
      },
      "required": ["id", "name", "language", "languageCode"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile"
        }
      },
      {
        "path": "/channels/{channelId}",
        "definition": {
          "entityName": "YouTubeChannel"
        }
      },
      {
        "path": "/videos/{videoId}",
        "definition": {
          "entityName": "YouTubeVideo"
        }
      },
      {
        "path": "/quran_translations/{translationId}",
        "definition": {
          "entityName": "QuranTranslation",
          "description": "Stores activated Quran translations. Publicly readable, admin writable."
        }
      },
      {
        "path": "/roles_admin/{adminId}",
        "definition": {
          "entityName": "UserProfile"
        }
      }
    ]
  }
}
