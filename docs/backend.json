
{
  "entities": {
    "Video": {
      "title": "Video",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "channelId": { "type": "string" },
        "publishedAt": { "type": "string" },
        "isTrending": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "appViewCount": { "type": "number" }
      }
    },
    "Language": {
      "title": "Language",
      "description": "ISO 639-1 Language mapping for the platform.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "isoCode": { "type": "string" }
      },
      "required": ["name", "isoCode"]
    },
    "HadithBook": {
      "title": "Hadith Book",
      "description": "A primary canonical collection of Hadith (e.g. Sahih Bukhari).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bookName": { "type": "string" },
        "editionCount": { "type": "number" },
        "lastSyncedAt": { "type": "string" }
      }
    },
    "HadithEdition": {
      "title": "Hadith Edition",
      "description": "A specific language version of a Hadith book from the API registry.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bookId": { "type": "string" },
        "name": { "type": "string" },
        "author": { "type": "string" },
        "language": { "type": "string" },
        "has_sections": { "type": "boolean" },
        "direction": { "type": "string" },
        "source": { "type": "string" },
        "comments": { "type": "string" },
        "link": { "type": "string" },
        "linkmin": { "type": "string" },
        "dataSync": { "type": "string", "enum": ["yes", "no"] },
        "indexSynced": { "type": "string", "enum": ["yes", "no"] }
      }
    },
    "HadithReference": {
      "title": "Hadith Reference",
      "description": "Unique mapping of internal API references to maintain uniqueness across editions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "hadithId": { "type": "string" },
        "bookId": { "type": "string" },
        "editionId": { "type": "string" },
        "refBook": { "type": "number" },
        "refHadith": { "type": "number" }
      }
    },
    "HadithIndex": {
      "title": "Hadith Index",
      "description": "Chapter structure for a specific edition.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "editionId": { "type": "string" },
        "bookSlug": { "type": "string" },
        "name": { "type": "string" },
        "sections": { "type": "object" },
        "sectionDetails": { "type": "object" },
        "syncedSections": { "type": "object" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "/videos/{videoId}": {
      "schema": "Video",
      "description": "Cataloged spiritual videos."
    },
    "/languages/{langId}": {
      "schema": "Language",
      "description": "Platform language ISO mappings."
    },
    "/hadith_books/{bookId}": {
      "schema": "HadithBook",
      "description": "Primary canonical Hadith collections."
    },
    "/hadith_editions/{editionId}": {
      "schema": "HadithEdition",
      "description": "Language-specific editions."
    },
    "/hadith_data/{contentId}": {
      "schema": "object",
      "description": "Individual Prophetic records."
    },
    "/hadith_index/{indexId}": {
      "schema": "HadithIndex",
      "description": "Chapter/Section definitions for a Hadith book."
    },
    "/hadith_reference/{refId}": {
      "schema": "HadithReference",
      "description": "Unique cross-edition Prophetic references."
    },
    "/roles_admin/{userId}": {
      "schema": "object",
      "description": "Admin security marker."
    },
    "/settings/{settingId}": {
      "schema": "object",
      "description": "Global application configuration."
    }
  }
}
