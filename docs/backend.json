
{
  "entities": {
    "HadithBook": {
      "title": "HadithBook",
      "type": "object",
      "description": "Represents a major Hadith collection (e.g., Sahih Bukhari).",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "editionCount": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name"]
    },
    "HadithEdition": {
      "title": "HadithEdition",
      "type": "object",
      "description": "Represents a specific edition or collection of Hadith.",
      "properties": {
        "id": { "type": "string" },
        "bookId": { "type": "string" },
        "collectionName": { "type": "string" },
        "title": { "type": "string" },
        "language": { "type": "string" },
        "textDirection": { "type": "string" },
        "sourceLink": { "type": "string" },
        "sourceLinkMin": { "type": "string" },
        "isActive": { "type": "boolean" },
        "lastSyncedAt": { "type": "string", "format": "date-time" },
        "hadithCount": { "type": "number" }
      },
      "required": ["id", "title", "language"]
    },
    "Video": {
      "title": "Video",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "channelId": { "type": "string" },
        "publishedAt": { "type": "string" },
        "isTrending": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "appViewCount": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "/hadith_books/{bookId}": {
      "schema": "HadithBook",
      "description": "Catalog of major Hadith books."
    },
    "/hadith_editions/{hadithEditionId}": {
      "schema": "HadithEdition",
      "description": "Registry of available Hadith books and language editions."
    },
    "/hadith_data/{contentId}": {
      "schema": "object",
      "description": "The actual text and translations of specific Hadiths."
    },
    "/videos/{videoId}": {
      "schema": "Video",
      "description": "Cataloged spiritual videos."
    },
    "/channels/{channelId}": {
      "schema": "object",
      "description": "Linked YouTube channels."
    },
    "/roles_admin/{userId}": {
      "schema": "object",
      "description": "Admin marker."
    },
    "/settings/{settingId}": {
      "schema": "object",
      "description": "Global config."
    },
    "/speakers/{speakerId}": {
      "schema": "object",
      "description": "Scholars and speakers."
    },
    "/quran/{surahId}": {
      "schema": "object",
      "description": "Quranic text."
    },
    "/quran_editions/{editionId}": {
      "schema": "object",
      "description": "Quran metadata."
    },
    "/quran_metadata/{metaId}": {
      "schema": "object",
      "description": "Structural Quran data."
    }
  }
}
