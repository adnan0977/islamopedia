
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // --- Public Content (Read for everyone, Write for Admin only) ---
    // Rules updated to be explicit for get/list to support complex studio queries.
    
    match /languages/{id} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /videos/{id} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    
    match /channels/{id} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    
    match /speakers/{id} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    
    match /quran/{id} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    
    match /quran_editions/{id} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    
    match /quran_metadata/{id} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // --- Hadith Library (Public Read, Admin Write) ---
    
    match /hadith_books/{id} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /hadith_editions/{id} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /hadith_index/{id} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /hadith_data/{id} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /hadith_reference/{id} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    
    match /settings/{id} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // --- Admin Access Control ---
    match /roles_admin/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      // Bootstrapping: Allow the primary user to initialize their own admin status
      allow create: if isSignedIn() && request.auth.uid == userId && request.resource.data.email == 'adnan@gmail.com';
      allow list, update, delete: if false;
    }
  }
}
