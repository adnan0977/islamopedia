/**
 * VlogNest Firestore Security Rules
 * 
 * Core Philosophy:
 * This ruleset implements a hybrid security model combining strict user-ownership with a 
 * role-based administrative layer (DBAC). Access is primarily determined by path-based 
 * authorization for user-specific data and ownership-field validation for shared 
 * collections like videos. Administrative privileges are granted via a dedicated 
 * collection check, allowing global management of content.
 * 
 * Data Structure:
 * - /users/{userId}: Private user profiles and settings.
 * - /users/{userId}/custom_index: AI-generated personalized content feeds.
 * - /channels, /videos: Global video content catalogs.
 * - /quran_surahs, /categories, /tags: Reference and religious content.
 * - /roles_admin: A control collection where document existence grants admin rights.
 * 
 * Key Security Decisions:
 * - Ownership Denormalization: The 'YouTubeVideo' entity includes 'uploadedByUserId' to 
 *   enable fast, non-recursive authorization for creators.
 * - Administrative Override: Users whose UID exists in the 'roles_admin' collection 
 *   are granted broad permissions to manage videos, channels, and religious content.
 * - Public vs. Private: Religious content (Quran) is publicly readable to allow 
 *   unauthenticated access, while user profiles and custom indexes are strictly private.
 * - Structural Segregation: User-specific data is nested under the /users/ path to 
 *   ensure clean list operations that never leak data between users.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    /** @description Checks if the user is authenticated. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the authenticated user's UID matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Checks if the user is an administrator based on the roles_admin collection. */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /** @description Validates ownership for an existing document about to be updated or deleted. */
    function isExistingOwner(ownerId) {
      return isSignedIn() && resource != null && (resource.data[ownerId] == request.auth.uid || isAdmin());
    }

    /** @description Validates ownership for a user-scoped path (e.g., /users/{userId}). */
    function isExistingPathOwner(userId) {
      return resource != null && (isOwner(userId) || isAdmin());
    }

    // --- Collection Rules ---

    /**
     * @description Administrative role management. Determines global admin privileges.
     * @path /roles_admin/{adminId}
     * @allow (get) request.auth.uid == adminId (to verify own status)
     * @deny (list) Denied to prevent admin discovery.
     * @principle DBAC (Database-Based Access Control) via existence.
     */
    match /roles_admin/{adminId} {
      allow get: if isOwner(adminId);
      allow list: if false;
      allow create, update, delete: if false; // Managed by system/Cloud Functions
    }

    /**
     * @description User profiles containing personal settings and Namaz location.
     * @path /users/{userId}
     * @allow (create) request.auth.uid == userId
     * @deny (update) If user attempts to modify another user's profile.
     * @principle Path-based ownership for private user data.
     */
    match /users/{userId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update, delete: if isExistingPathOwner(userId);
    }

    /**
     * @description AI-generated personalized content indexes for specific users.
     * @path /users/{userId}/custom_index/{indexId}
     * @allow (create) User matches path and provides matching userId in data.
     * @deny (update) Attempting to change the userId relationship.
     * @principle Relational integrity and path-based ownership.
     */
    match /users/{userId}/custom_index/{indexId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingPathOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingPathOwner(userId);
    }

    /**
     * @description YouTube Channel metadata.
     * @path /channels/{channelId}
     * @allow (list) All authenticated users.
     * @deny (create) Non-admin users attempting to add channels.
     * @principle Public read with admin-only writes.
     */
    match /channels/{channelId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description YouTube Video metadata including AI insights.
     * @path /videos/{videoId}
     * @allow (update) Original uploader or admin.
     * @deny (create) Mismatched uploadedByUserId in request body.
     * @principle Field-based ownership (uploadedByUserId) for content creators.
     */
    match /videos/{videoId} {
      allow get, list: if isSignedIn();
      allow create: if (isSignedIn() && request.resource.data.uploadedByUserId == request.auth.uid) || isAdmin();
      allow update: if (isExistingOwner('uploadedByUserId') && request.resource.data.uploadedByUserId == resource.data.uploadedByUserId) || isAdmin();
      allow delete: if isExistingOwner('uploadedByUserId') || isAdmin();
    }

    /**
     * @description Global categories for classifying videos.
     * @path /categories/{categoryId}
     * @allow (get) All authenticated users.
     * @deny (delete) Regular users.
     * @principle Admin-controlled taxonomy.
     */
    match /categories/{categoryId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Global tags for video searchability.
     * @path /tags/{tagId}
     * @allow (list) All authenticated users.
     * @deny (create) Non-admin users.
     * @principle Admin-controlled taxonomy.
     */
    match /tags/{tagId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Metadata for Quranic Surahs.
     * @path /quran_surahs/{surahId}
     * @allow (get) Publicly accessible (unauthenticated).
     * @deny (write) Any non-admin user.
     * @principle Publicly accessible religious content.
     */
    match /quran_surahs/{surahId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Detailed Quranic Ayats (verses).
     * @path /quran_surahs/{surahId}/ayats/{ayahId}
     * @allow (get) Publicly accessible.
     * @deny (update) Regular users.
     * @principle Publicly accessible religious content with hierarchical nesting.
     */
    match /quran_surahs/{surahId}/ayats/{ayahId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}