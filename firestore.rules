
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // --- Public Content (Read for everyone, Write for Admin only) ---
    
    // Explicitly allowing list and get for spiritual collections to resolve permission errors
    match /hadith_books/{id} { allow read: if true; allow write: if isAdmin(); }
    match /hadith_editions/{id} { allow read: if true; allow write: if isAdmin(); }
    match /hadith_data/{id} { allow read: if true; allow write: if isAdmin(); }
    match /hadith_metadata/{id} { allow read: if true; allow write: if isAdmin(); }
    
    match /videos/{id} { allow read: if true; allow write: if isAdmin(); }
    match /channels/{id} { allow read: if true; allow write: if isAdmin(); }
    match /speakers/{id} { allow read: if true; allow write: if isAdmin(); }
    match /quran/{id} { allow read: if true; allow write: if isAdmin(); }
    match /quran_editions/{id} { allow read: if true; allow write: if isAdmin(); }
    match /quran_metadata/{id} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }

    // --- Admin Access Control ---
    
    match /roles_admin/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }
  }
}
