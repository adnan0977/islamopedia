rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Hadith Admin Panel & Public Catalog Security Rules
     * 
     * Core Philosophy: 
     * This ruleset implements a Database Access Control (DBAC) model where specific administrative 
     * privileges are decoupled from the data being managed. Public content is globally readable, 
     * while write operations are strictly reserved for users identified as administrators.
     * 
     * Data Structure:
     * - /hadith_editions/{hadithEditionId}: Publicly accessible metadata for Hadith collections.
     * - /roles_admin/{userId}: A restricted collection where the presence of a document 
     *   grants administrative rights to the user with the corresponding UID.
     * 
     * Key Security Decisions:
     * - Structural Segregation: Administrative roles are stored in a separate collection 
     *   (/roles_admin) to prevent data pollution and simplify authorization logic.
     * - Authorization Independence: Writing to Hadith editions does not depend on data 
     *   within the edition document itself, but on the user's status in the roles collection.
     * - Relational Integrity: On creation, the rules enforce that the internal 'id' field 
     *   matches the document ID in the path to ensure data consistency.
     * - Immutability: Critical identifier fields are made immutable after creation.
     */

    // --- Helper Functions ---

    /** @description Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the authenticated user's UID matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Checks if the user has a document in the roles_admin collection. */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /** @description Combines admin check with document existence for destructive operations. */
    function isExistingAdmin() {
      return isAdmin() && resource != null;
    }

    // --- Collection Rules ---

    /**
     * @description Provides read-only access to users for checking their own admin status.
     * @path /roles_admin/{userId}
     * @allow (get) If the user is the owner of the document (UID matches).
     * @deny (list) Prevent discovery of all administrative users.
     * @principle Ownership-based access for identity verification.
     */
    match /roles_admin/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update, delete: if false; // Roles are managed externally/manually.
    }

    /**
     * @description Manages metadata for Hadith collections. Publicly readable, admin writeable.
     * @path /hadith_editions/{hadithEditionId}
     * @allow (list/get) Any user (public access).
     * @allow (create) An authenticated admin user where data 'id' matches the path.
     * @deny (create) Non-admin users or mismatched 'id' field.
     * @principle Public Read with Role-Based Writes (DBAC).
     */
    match /hadith_editions/{hadithEditionId} {
      allow get, list: if true;
      
      allow create: if isAdmin() && request.resource.data.id == hadithEditionId;
      
      allow update: if isExistingAdmin() && request.resource.data.id == resource.data.id;
      
      allow delete: if isExistingAdmin();
    }
  }
}