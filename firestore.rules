
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- SYSTEM SECURITY METADATA ---
    // Rules Version: 1.0.8 (Explicit Hadith Access)
    // Last Updated: March 2024

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // --- Hadith Library (Public Read, Admin Write) ---
    // Specifically placed at the top to ensure priority and visibility.
    
    match /hadith_books/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hadith_editions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hadith_index/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hadith_data/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hadith_reference/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Public Content ---
    
    match /languages/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /videos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /channels/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /speakers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /quran/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /quran_editions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /quran_metadata/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Admin Access Control ---
    match /roles_admin/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      
      // Bootstrapping: Allow the primary developer to initialize their own admin document.
      allow create: if isSignedIn() 
                    && request.auth.uid == userId 
                    && request.resource.data.email == 'adnan@gmail.com';
      
      allow list, update, delete: if false;
    }
  }
}
