
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // --- Public Content (Always Readable) ---
    
    match /videos/{videoId} {
      allow read: if true;
      allow create: if (isSignedIn() && request.resource.data.uploadedByUserId == request.auth.uid) || isAdmin();
      allow update, delete: if (isSignedIn() && (resource.data.uploadedByUserId == request.auth.uid || isAdmin()));
    }

    match /channels/{channelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /speakers/{speakerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /quran_surahs/{surahId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /ayats/{ayahId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /tags/{tagId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Private User Data ---

    match /users/{userId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update, delete: if isOwner(userId) || isAdmin();
      
      match /custom_index/{indexId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId) || isAdmin();
      }
    }

    // Roles management
    match /roles_admin/{adminId} {
      allow get: if isOwner(adminId);
      allow list: if isAdmin();
      allow write: if false; 
    }
  }
}
