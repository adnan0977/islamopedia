
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      // Check if a document exists in the roles_admin collection for the current user
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // --- Collection Rules ---
    
    // Roles management - only the user themselves can check their admin status
    match /roles_admin/{adminId} {
      allow get: if isOwner(adminId);
      allow list: if isAdmin();
      allow create, update, delete: if false; 
    }

    // User profiles - private to each user
    match /users/{userId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update, delete: if isOwner(userId) || isAdmin();
      
      // Personalized index
      match /custom_index/{indexId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // YouTube Channels - Publicly readable
    match /channels/{channelId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // YouTube Videos - Publicly readable
    match /videos/{videoId} {
      allow get, list: if true;
      allow create: if (isSignedIn() && request.resource.data.uploadedByUserId == request.auth.uid) || isAdmin();
      allow update, delete: if (isSignedIn() && (resource.data.uploadedByUserId == request.auth.uid || isAdmin()));
    }

    // Speakers/Scholars - Publicly readable
    match /speakers/{speakerId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Global Metadata - Publicly readable
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    match /tags/{tagId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Quran Content - Publicly readable
    match /quran_surahs/{surahId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
      
      match /ayats/{ayahId} {
        allow get, list: if true;
        allow create, update, delete: if isAdmin();
      }
    }
  }
}
